# =============================================================================
# Enterprise RAG Intelligence Platform - backend configuration
# Copy to backend/.env and adjust. NEVER commit the real .env file.
# =============================================================================

# --- Application -------------------------------------------------------------
APP_NAME="Enterprise RAG Intelligence Platform"
ENVIRONMENT=development            # development | test | production
LOG_LEVEL=INFO
LOG_JSON=true
API_PREFIX=/api/v1
CORS_ORIGINS=["http://localhost:5173","http://localhost:8080"]

# --- Security ----------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=change-me-to-a-long-random-string-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Comma-free JSON list of emails that receive the admin role on registration
ADMIN_EMAILS=["admin@example.com"]
RATE_LIMIT_PER_MINUTE=120
AUTH_RATE_LIMIT_PER_MINUTE=10

# --- Database (PostgreSQL + pgvector) ----------------------------------------
# Host port 5442 is used because 5432 is often taken by other local Postgres instances.
DATABASE_URL=postgresql+asyncpg://rag:rag_password@localhost:5442/rag_platform
TEST_DATABASE_URL=postgresql+asyncpg://rag:rag_password@localhost:5442/rag_test
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=10

# --- Redis -------------------------------------------------------------------
REDIS_URL=redis://localhost:6380/0
CACHE_ENABLED=true
EMBEDDING_CACHE_TTL_SECONDS=86400
RETRIEVAL_CACHE_TTL_SECONDS=600

# --- File uploads --------------------------------------------------------------
STORAGE_DIR=./storage
MAX_UPLOAD_SIZE_MB=25

# --- Embeddings ----------------------------------------------------------------
EMBEDDING_PROVIDER=sentence-transformers   # sentence-transformers | hash (tests only)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# MUST match the vector column dimension created by the Alembic migration.
EMBEDDING_DIMENSION=384
EMBEDDING_BATCH_SIZE=32
EMBEDDING_DEVICE=cpu

# --- Reranking -----------------------------------------------------------------
RERANKER_ENABLED=true
RERANKER_PROVIDER=cross-encoder            # cross-encoder | none
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
# Liberal cut-off: retrieval maximises recall; answerability is decided at the answer stage.
RERANK_MIN_SCORE=-10

# --- Chunking defaults (users can override in Settings) -------------------------
# Measured in embedding-model tokens; must be <= model max_seq_length - 2 (254 for MiniLM).
CHUNK_STRATEGY=recursive                   # fixed | recursive | sentence
CHUNK_SIZE_TOKENS=200
CHUNK_OVERLAP_TOKENS=40

# --- Retrieval defaults ----------------------------------------------------------
RETRIEVAL_TOP_K=5
RETRIEVAL_CANDIDATE_MULTIPLIER=4
SIMILARITY_THRESHOLD=0.25
RRF_K=60
SEARCH_MODE=hybrid                         # vector | keyword | hybrid
QUERY_EXPANSION=none                       # none | prf | multi_query (PRF hurt on the sample benchmark)
CONTEXT_MAX_TOKENS=2500

# --- Semantic answer cache (stateless questions only) ----------------------------
SEMANTIC_CACHE_ENABLED=true
SEMANTIC_CACHE_THRESHOLD=0.95
SEMANTIC_CACHE_TTL_SECONDS=3600
SEMANTIC_CACHE_MAX_ENTRIES=200

# --- LLM (LiteLLM) -----------------------------------------------------------------
# "local" = built-in extractive answerer, no API key, no cost.
# Any other value is passed to LiteLLM, e.g.:
#   gpt-4o-mini                    (needs OPENAI_API_KEY)
#   anthropic/claude-haiku-5-5     (needs ANTHROPIC_API_KEY)
#   gemini/gemini-2.0-flash        (needs GEMINI_API_KEY)
#   ollama/llama3.2                (needs a running Ollama; set OLLAMA_API_BASE)
LLM_DEFAULT_MODEL=local
LLM_ALLOWED_MODELS=["local","gpt-4o-mini","anthropic/claude-haiku-5-5","gemini/gemini-2.0-flash","ollama/llama3.2"]
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=2
LLM_TEMPERATURE=0.1
LLM_MAX_OUTPUT_TOKENS=700
# Local mode only: best sentence-level cross-encoder logit required to answer
# (calibrated on the dev set; see docs/EVALUATION.md).
LOCAL_ANSWER_MIN_LOGIT=1.0
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# OLLAMA_API_BASE=http://localhost:11434

# --- Conversation memory -----------------------------------------------------------
HISTORY_RECENT_TURNS=4
HISTORY_RELEVANT_TURNS=2
